<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><View android:id="@+id/widget_accent" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/widget_accent_pill" /><TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="下一节课" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_on_surface_variant" /></LinearLayout>
    <TextView android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="暂无课程" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_on_surface" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="今天没有安排课程" android:textSize="12sp" android:textColor="@color/widget_on_surface_variant" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>