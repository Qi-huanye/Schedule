<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F1F8F5">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Schedule" android:textSize="18sp" android:textStyle="bold" android:textColor="#175D53" />
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="10dp" android:textSize="14sp" android:textColor="#233E37" android:maxLines="14" android:ellipsize="end" />
</LinearLayout>
